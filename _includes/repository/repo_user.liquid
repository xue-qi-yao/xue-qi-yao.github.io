{% assign meta = site.data.github.users[include.username] %}

<div class="repo p-2">
  <a
    class="repo-card repo-card-user"
    href="{{ meta.html_url | default: 'https://github.com/' | append: include.username }}"
    aria-label="{{ include.username }} on GitHub"
  >
    <div class="repo-user-head">
      {% if meta.avatar_url %}
        <img class="repo-avatar" src="{{ meta.avatar_url }}&s=160" alt="{{ include.username }}" loading="lazy">
      {% endif %}
      <div>
        <div class="repo-card-title">{{ meta.name | default: include.username }}</div>
        <div class="repo-user-login">@{{ include.username }}</div>
      </div>
    </div>

    {% if meta.bio %}
      <p class="repo-desc">{{ meta.bio }}</p>
    {% endif %}

    {% if meta %}
      <div class="repo-stats">
        <span><i class="fa-solid fa-book" aria-hidden="true"></i>{{ meta.public_repos }} repos</span>
        {% if meta.total_stars %}
          <span><i class="fa-solid fa-star" aria-hidden="true"></i>{{ meta.total_stars }} stars</span>
        {% endif %}
        <span><i class="fa-solid fa-user-group" aria-hidden="true"></i>{{ meta.followers }} followers</span>
      </div>
    {% endif %}
  </a>
</div>
