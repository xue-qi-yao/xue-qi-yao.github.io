{% assign meta = site.data.github.repos[include.repository] %}
{% assign parts = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains parts[0] %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}
{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}
{% if meta.language %}
  {% assign lang_color = site.data.github_language_colors[meta.language] | default: 'var(--global-theme-color)' %}
{% endif %}

<div class="repo p-2">
  <a
    class="repo-card"
    href="{{ meta.html_url | default: 'https://github.com/' | append: include.repository }}"
    aria-label="{{ include.repository }} on GitHub"
  >
    <div class="repo-card-title">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <span>
        {% if show_owner -%}
          <span class="repo-owner">{{ parts[0] }}/</span>
        {%- endif -%}
        <span class="repo-name">{{ parts[1] }}</span>
      </span>
    </div>

    {% if meta.description %}
      <p class="repo-desc" style="-webkit-line-clamp: {{ max_lines }};">{{ meta.description }}</p>
    {% elsif meta == null %}
      <p class="repo-desc repo-desc-missing">Repository details unavailable at build time.</p>
    {% endif %}

    {% if meta %}
      <div class="repo-stats">
        {% if meta.language %}
          <span><span class="repo-lang-dot" style="background-color: {{ lang_color }};"></span>{{ meta.language }}</span>
        {% endif %}
        <span><i class="fa-solid fa-star" aria-hidden="true"></i>{{ meta.stargazers_count }}</span>
        <span><i class="fa-solid fa-code-fork" aria-hidden="true"></i>{{ meta.forks_count }}</span>
      </div>
    {% endif %}
  </a>
</div>
